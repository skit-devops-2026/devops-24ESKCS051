# Copy this file to ".env" and fill in your own values.
# Never commit the real ".env" file - it's already in .gitignore.

# --- Database ---
# Option A (simplest, no install): MongoDB Atlas free cluster.
#   Sign up at https://www.mongodb.com/cloud/atlas/register, create a free
#   cluster, click "Connect" -> "Drivers", and copy the connection string.
#   It looks like: mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/zenith
#
# Option B: MongoDB running on your own machine.
#   MONGO_URI=mongodb://localhost:27017/zenith
MONGO_URI=mongodb://localhost:27017/zenith

# --- Auth ---
# Any long random string works. This is used to sign login tokens (JWT).
JWT_SECRET=change_this_to_a_long_random_string

# --- Server ---
PORT=5000
